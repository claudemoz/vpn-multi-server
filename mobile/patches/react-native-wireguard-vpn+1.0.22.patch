+            stopTunnel()
+            promise.reject("CONNECT_ERROR", "Le serveur VPN n’a pas accepté la connexion")
+            return
+        }
+        worker.schedule({ pollHandshake(id, deadline, promise) }, HANDSHAKE_POLL_MS, TimeUnit.MILLISECONDS)
+    }
 
