# Server
APP_ENV=development
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wg-vpn-platform
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRATION_HOURS=2160

# WireGuard
WG_DEFAULT_SUBNET=10.8.0.0/24
WG_DNS=1.1.1.1,8.8.8.8
WG_ALLOWED_IPS=0.0.0.0/0,::/0
WG_KEEPALIVE=25
# Client tunnel MTU (0 = let the client decide). 1280 avoids fragmentation on every network.
WG_MTU=1280
# ULA prefix for the devices' IPv6 tunnel address (<prefix>::<device IPv4>), "off" to disable.
# Must match WG_IPV6_PREFIX given to scripts/setup-wg-server.sh on every VPN server.
WG_IPV6_PREFIX=fd7a:5f1c:9e42::/64

# Agents (gRPC link control plane -> VPN servers)
# Shared secret sent as "authorization: Bearer <token>"; must match AGENT_TOKEN on every agent.
AGENT_TOKEN=change_me_agent_token
# TLS: path to the CA that signed the agents' certificates. Empty = plaintext (dev only).
AGENT_TLS_CA=
AGENT_TLS_SERVER_NAME=
AGENT_DIAL_TIMEOUT=5s
AGENT_CALL_TIMEOUT=10s
# Background reconciler: resyncs every active server and collects handshakes.
AGENT_SYNC_ENABLED=true
AGENT_SYNC_INTERVAL=30s

# --- Agent process (cmd/agent, one per VPN server) ---
# AGENT_LISTEN=:50051
# WG_INTERFACE=wg0
# AGENT_BACKEND=wgctrl          # or "memory" for local development
# AGENT_TOKEN=change_me_agent_token
# AGENT_INSECURE_NO_AUTH=false
# AGENT_TLS_CERT=/etc/wg-agent/server.crt
# AGENT_TLS_KEY=/etc/wg-agent/server.key
